{
  "name": "grok",
  "installPaths": {
    "home": { "skills": ".grok/skills", "commands": ".grok/commands", "rules": ".grok/AGENTS.md" },
    "project": { "skills": ".grok/skills", "commands": ".grok/commands" }
  },
  "argSyntax": "$ARGUMENTS",
